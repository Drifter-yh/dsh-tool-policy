{
  "name": "dsh-tool-policy",
  "version": "0.1.0",
  "description": "Declarative, fail-closed tool-call policy for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
